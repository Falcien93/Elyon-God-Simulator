{
  "name": "elyon",
  "productName": "Elyon",
  "version": "1.0.0",
  "description": "A mythic simulator of the first garden. Play as Elyon, shape Eden, and walk among the first people.",
  "author": "Elyon",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/game.test.js test/campaign.test.js test/saves.test.js test/release.test.js test/playthrough.test.js test/security.test.js test/site.test.js",
    "capture:site": "ELECTRON_DISABLE_SANDBOX=1 electron scripts/capture-site.mjs",
    "dist": "electron-builder --linux dir AppImage",
    "dist:dir": "electron-builder --linux dir",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elyon.garden",
    "productName": "Elyon",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "splash.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets/icons",
      "synopsis": "A mythic simulator of the first garden.",
      "executableName": "elyon"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elyon"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "notarize": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.games"
    }
  }
}
