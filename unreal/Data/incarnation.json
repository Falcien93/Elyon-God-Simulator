  "lines": {
    "enter": "A human form stands in the settlement. The sky acts wait.",
    "welcome": "They make room.",
    "wary": "They keep a distance and watch.",
    "hostile": "Fear has the crowd. They have not turned.",
    "crucifixion": "The one who walked with them is no longer among the living. The moment is not shown.",
    "underworld": "A passage under the settlement. The lost can speak. There is nothing here to win.",
    "returned": "The same human form stands again at the center. The work can resume.",
    "ascended": "The god view wakes. The ending locked in the garden stays locked.",
    "peace": "They did not turn. The walk ends with no death."
  },
  "meetLines": {
    "leader": "You have come down to our height. Speak, and I will answer as myself.",
    "prophet": "I dreamed a light that had hands. I did not think it would stand in the road."
  },
  "returnProphet": "You went where we could not follow, and you are standing here. I will say so.",
